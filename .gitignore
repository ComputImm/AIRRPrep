# Build output and caches
__pycache__/
*.py[cod]
node_modules/
dist/
.output/
.vinxi/
.tanstack/
.nitro/
.wrangler/
venv/
.venv/

# Secrets and per-deployment state
.env
.env.*
!.env.example
jobs/
uploads/
outputs/
results/
temp/

# Large release evidence: attach to the tagged release, do not commit
release-artifacts/*.tar.gz

# Regenerable working directories of the validation harnesses
paper/test/component_matrix/work/
paper/test/validation_output/

# LaTeX build products. Scoped to the manuscript directory on purpose: a bare
# *.log would also swallow paper/test/trust4-test/*.log, which are the
# archived records of the TRUST4 runs behind Supplementary Table S7.
paper/manuscript/*.aux
paper/manuscript/*.log
paper/manuscript/*.out
paper/manuscript/*.toc
paper/manuscript/*.fls
paper/manuscript/*.fdb_latexmk
paper/manuscript/*.synctex.gz
