
# Required — no default. Generate with  openssl rand -hex 24
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

REDIS_URL=redis://:CHANGE_ME_REDIS_PASSWORD@localhost:6836/0

ALLOWED_ORIGINS=http://localhost:8080

BACKEND_PORT=8000

# --- CPU budget ------------------------------------------------------------
# Fraction of the host's cores the containers may use.
CPU_FRACTION=0.6667

# --- Email notifications ---------------------------------------------------

SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD='pas$word'
SMTP_SECURITY=
MAIL_FROM=


# Public URL of the *frontend*. Used to build the "come back to your run"
PUBLIC_APP_URL=http://localhost:8080

NOTIFY_MIN_SECONDS=300
NOTIFY_MIN_INPUT_MB=150

TRACKED_JOB_TTL_DAYS=7

EMAIL_CODE_TTL=900
EMAIL_CODE_MAX_ATTEMPTS=5
EMAIL_CODE_RESEND_COOLDOWN=60

CAPTCHA_ENABLED=true
CAPTCHA_TTL=300
CAPTCHA_LENGTH=5

# HMAC key for the email lookup value on tracking records. Generate with
# python -c "import secrets; print(secrets.token_hex(32))" and keep it stable.
EMAIL_HASH_SECRET=CHANGE_ME_EMAIL_HASH_SECRET

MAX_UPLOAD_SIZE_MB=200

# --- Single-cell / TRUST4 --------------------------------------------------
# TRUST4 is compiled into the image and its references are baked in at
# /opt/trust4/references, so nothing below is required. Override only to pin
# a different TRUST4 release or to point at a mounted reference volume.
TRUST4_VERSION=1.1.9
TRUST4_REF_DIR=/opt/trust4/references
TRUST4_DEFAULT_SPECIES=human
# Leave blank to follow CPU_FRACTION below; set a number to pin thread count.
TRUST4_THREADS=
# Seconds before one assembly is killed (0 disables the cap).
TRUST4_TIMEOUT=21600
# Optional path to a 10x barcode whitelist (not shipped in the image).
TRUST4_BARCODE_WHITELIST=
